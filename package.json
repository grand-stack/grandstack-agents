{
  "name": "grandstack-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "How agents work with GraphQL: direct queries and mutations, or an MCP server that runs GraphQL statements",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:stdio": "tsx src/stdio.ts",
    "mcp:http": "tsx src/http.ts",
    "agent": "tsx examples/direct/agent.ts",
    "live": "tsx scripts/live-check.ts",
    "docs:check": "node scripts/check-links.mjs",
    "container": "tsx scripts/container-check.ts",
    "auth:check": "tsx examples/with-auth/check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "graphql": "16.14.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
